{
  "name": "green-goods",
  "version": "2.0.1",
  "type": "module",
  "private": true,
  "keywords": [
    "green-goods",
    "green-goods-protocol",
    "pwa",
    "web3",
    "dapp",
    "ethereum",
    "solidity",
    "react",
    "tailwind",
    "typescript",
    "bun",
    "foundry"
  ],
  "scripts": {
    "setup": "node scripts/dev/setup.js",
    "dev": "node scripts/dev/stack.js",
    "dev:health": "node scripts/dev/doctor.js",
    "dev:smoke": "node scripts/dev/smoke.js",
    "dev:clean": "node scripts/dev/clean.js",
    "env:sync": "node scripts/dev/env-sync.js",
    "env:check": "node scripts/dev/env-check.js",
    "check": "node scripts/dev/ci-local.js",
    "test": "node scripts/dev/test.js",
    "build": "bun run --cwd packages/contracts build && bun run --cwd packages/shared build && bun run --cwd packages/indexer build && bun run --cwd packages/client build && bun run --cwd packages/admin build",
    "lint": "node scripts/quality/check-react-patterns.js && bun --bun run oxlint packages/client/src packages/admin/src packages/shared/src packages/indexer/src packages/agent/src packages/contracts/script --deny-warnings && bun run --cwd packages/contracts lint --check",
    "format": "node scripts/dev/package-commands.mjs root format",
    "contracts": "node packages/contracts/script/cli.mjs",
    "browser": "node scripts/dev/browser.js",
    "qa": "node scripts/agents/qa.mjs",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall/fix-multiformats.js"
  },
  "overrides": {
    "abitype": "1.3.0",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "@isaacs/brace-expansion": "5.0.1",
    "axios": "1.21.0",
    "compression": "1.8.2",
    "defu": "6.1.7",
    "dompurify": "3.4.17",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.2",
    "form-data": "4.0.6",
    "h3": "1.15.6",
    "image-size": "2.0.3",
    "immutable": "4.3.9",
    "joi": "17.13.9",
    "multiformats": "^14.0.5",
    "uint8arrays": "^6.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "postcss": "8.5.26",
    "protobufjs": "7.6.1",
    "proxy-addr": "2.0.8",
    "basic-ftp": "5.3.1",
    "hono": "4.13.17",
    "rollup": "4.59.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "node-forge": "1.4.3",
    "serve-handler": "6.1.7",
    "sharp": "0.35.5",
    "shell-quote": "1.12.0",
    "socket.io-parser": "4.2.7",
    "svgo": "3.3.5",
    "systeminformation": "5.33.16",
    "tinypool": "2.2.0",
    "vite": "8.3.6",
    "websocket-driver": "0.7.5",
    "ethers": "6.17.0",
    "viem": "2.55.19"
  },
  "resolutions": {
    "uint8arrays": "^6.1.1"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "ethers": "6.17.0",
    "gql.tada": "^1.11.4",
    "multiformats": "^14.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uint8arrays": "^6.1.1",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@biomejs/biome": "2.4.16",
    "@google/design.md": "0.4.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "1.65.0",
    "@posthog/cli": "0.19.0",
    "@rolldown/plugin-babel": "0.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "7.20.5",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/blob": "^2.8.2",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "exceljs": "4.4.0",
    "fake-indexeddb": "^6.2.7",
    "graphql": "16.15.0",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "js-yaml": "5.5.0",
    "jsdom": "31.0.0",
    "knip": "^6.44.2",
    "lighthouse": "13.6.0",
    "lint-staged": "17.6.0",
    "modern-web-guidance": "^0.0.197",
    "oxlint": "1.67.0",
    "pm2": "7.1.2",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~7.0.2",
    "vite": "8.3.6",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "5.1.0",
    "wait-port": "1.1.0"
  },
  "engines": {
    "node": ">=22.19.0 <23",
    "bun": ">=1.x"
  },
  "packageManager": "bun@1.4.4",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "bash -c 'files=\"$@\"; filtered=$(echo \"$files\" | tr \" \" \"\\n\" | grep -Ev \"packages/contracts/(\\\\.generated|out)/\"); [ -n \"$filtered\" ] && echo \"$filtered\" | xargs bunx @biomejs/biome format --write || true' --"
    ]
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ],
  "description": "Green Goods helps communities name their needs, make promises, document regenerative work, review it together, and turn the record into support.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": "",
  "license": "MIT",
  "patchedDependencies": {
    "react-docgen-typescript@2.4.0": "patches/react-docgen-typescript@2.4.0.patch"
  }
}
