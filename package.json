{
  "name": "green-goods",
  "version": "1.2.1",
  "type": "module",
  "private": true,
  "keywords": [
    "green-goods",
    "green-goods-protocol",
    "pwa",
    "web3",
    "dapp",
    "ethereum",
    "solidity",
    "react",
    "tailwind",
    "typescript",
    "bun",
    "foundry"
  ],
  "scripts": {
    "setup": "node scripts/dev/setup.js",
    "dev": "node scripts/dev/stack.js",
    "dev:health": "node scripts/dev/doctor.js",
    "dev:smoke": "node scripts/dev/smoke.js",
    "dev:clean": "node scripts/dev/clean.js",
    "env:sync": "node scripts/dev/env-sync.js",
    "env:check": "node scripts/dev/env-check.js",
    "check": "node scripts/dev/ci-local.js",
    "test": "node scripts/dev/test.js",
    "build": "bun run --cwd packages/contracts build && bun run --cwd packages/shared build && bun run --cwd packages/indexer build && bun run --cwd packages/client build && bun run --cwd packages/admin build",
    "lint": "node scripts/quality/check-react-patterns.js && bun --bun run oxlint packages/client/src packages/admin/src packages/shared/src packages/indexer/src packages/agent/src packages/contracts/script --deny-warnings && bun run --cwd packages/contracts lint --check",
    "format": "node scripts/dev/package-commands.mjs root format",
    "contracts": "node packages/contracts/script/cli.mjs",
    "browser": "node scripts/dev/browser.js",
    "qa": "node scripts/agents/qa.mjs",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall/fix-multiformats.js"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "@isaacs/brace-expansion": "5.0.1",
    "axios": "1.16.0",
    "defu": "6.1.7",
    "fast-uri": "3.1.2",
    "form-data": "4.0.6",
    "h3": "1.15.6",
    "immutable": "4.3.8",
    "multiformats": "^13.4.2",
    "uint8arrays": "^5.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "protobufjs": "7.6.1",
    "basic-ftp": "5.3.1",
    "hono": "4.13.5",
    "rollup": "4.59.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "node-forge": "1.4.0",
    "serve-handler": "6.1.7",
    "sharp": "0.35.3",
    "shell-quote": "1.10.0",
    "socket.io-parser": "4.2.6",
    "svgo": "3.3.3",
    "systeminformation": "5.31.7",
    "vite": "8.2.1",
    "websocket-driver": "0.7.5",
    "ethers": "6.17.0",
    "viem": "2.55.0"
  },
  "resolutions": {
    "uint8arrays": "^5.1.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ethers": "6.17.0",
    "gql.tada": "^1.11.2",
    "multiformats": "^13.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uint8arrays": "^5.1.1",
    "viem": "2.55.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.4.15",
    "@google/design.md": "0.1.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.60.0",
    "@posthog/cli": "0.7.11",
    "@rolldown/plugin-babel": "0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vercel/blob": "^2.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "exceljs": "4.4.0",
    "fake-indexeddb": "^6.2.5",
    "graphql": "16.14.2",
    "husky": "^9.1.7",
    "js-yaml": "5.2.2",
    "jsdom": "29.1.1",
    "knip": "^6.26.0",
    "lighthouse": "13.2.0",
    "lint-staged": "16.1.5",
    "modern-web-guidance": "^0.0.169",
    "msw": "2.14.6",
    "oxlint": "1.66.0",
    "pm2": "6.0.14",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "~7.0.2",
    "vite": "8.2.1",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "4.1.11",
    "wait-port": "1.1.0"
  },
  "engines": {
    "node": ">=22.19.0 <23",
    "bun": ">=1.x"
  },
  "packageManager": "bun@1.4.2",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "bash -c 'files=\"$@\"; filtered=$(echo \"$files\" | tr \" \" \"\\n\" | grep -Ev \"packages/contracts/(\\\\.generated|out)/\"); [ -n \"$filtered\" ] && echo \"$filtered\" | xargs bunx @biomejs/biome format --write || true' --"
    ]
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ],
  "description": "A progressive web application for the Green Goods protocol.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": "",
  "license": "MIT",
  "patchedDependencies": {
    "react-docgen-typescript@2.4.0": "patches/react-docgen-typescript@2.4.0.patch"
  }
}
