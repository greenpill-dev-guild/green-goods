{
  "name": "@green-goods/admin",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "predev": "node ../../scripts/dev/check-port.js 3002 admin",
    "dev": "APP_ENV=development node ../../scripts/dev/node-cli.js vite",
    "test": "node ../../scripts/dev/package-commands.mjs admin test",
    "format": "node ../../scripts/dev/package-commands.mjs admin format",
    "lint": "bun --bun run oxlint src --deny-warnings",
    "build": "cd ../.. && APP_ENV=production node scripts/dev/node-cli.js tsc -b packages/admin/tsconfig.json && APP_ENV=production node scripts/dev/node-cli.js vite build --config packages/admin/vite.config.ts && node scripts/dev/remove-public-sourcemaps.js packages/admin/dist",
    "preview": "cd ../.. && APP_ENV=production bun --bun vite preview --config packages/admin/vite.config.ts",
    "typecheck": "node ../../scripts/dev/package-commands.mjs admin typecheck"
  },
  "dependencies": {
    "@green-goods/shared": "workspace:*",
    "@hookform/resolvers": "7.0.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@remixicon/react": "4.9.0",
    "@reown/appkit": "1.8.24",
    "@sentry/react": "11.11.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-persist-client": "5.107.1",
    "@xstate/react": "^6.1.0",
    "idb-keyval": "6.3.0",
    "posthog-js": "1.447.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-intl": "^12.1.6",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1",
    "viem": "2.55.19",
    "wagmi": "^3.7.11",
    "xstate": "5.33.3",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@rolldown/plugin-babel": "0.3.0",
    "@sentry/vite-plugin": "11.11.0",
    "@storybook/react": "10.6.6",
    "@types/babel__core": "7.20.5",
    "@vitejs/plugin-react": "6.2.1",
    "abitype": "1.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.5",
    "typescript": "~7.0.2",
    "vite": "8.3.6",
    "vite-plugin-mkcert": "2.1.0"
  }
}
