{
  "ignoreCommand": "node ../../scripts/ops/vercel-ignore.mjs admin",
  "installCommand": "cd ../.. && rm -rf node_modules packages/*/node_modules docs/node_modules && bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    {
      "src": "/assets/(.*)\\.map",
      "status": 404
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
