{
  "ignoreCommand": "node ../../scripts/ops/vercel-ignore.mjs admin",
  "installCommand": "cd ../.. && rm -rf node_modules packages/*/node_modules docs/node_modules && bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "develop": true,
      "alpha": true
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)\\.map",
      "status": 404
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "alpha.admin.greengoods.app" }],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
