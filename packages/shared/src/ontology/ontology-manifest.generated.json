  "claims": [
    {
      "id": "offline-first-documentation",
      "claim": "Communities document regenerative work offline and sync when connectivity returns.",
      "maturity": "available",
      "safe_wording": "The app works offline; queued work syncs automatically for passkey accounts and after a confirmation step for external wallets."
    },
    {
      "id": "work-attested-at-submission",
      "claim": "Field work becomes a permanent on-chain record at submission — or the moment it syncs, when captured offline.",
      "maturity": "available",
      "safe_wording": "Work is attested on-chain at submission (offline submissions attest when the queue syncs); operator approval adds a separate linked approval attestation with confidence and verification method."
    },
    {
      "id": "passkey-onboarding",
      "claim": "Gardeners sign in with a passkey — no seed phrase, no wallet setup.",
      "maturity": "available",
      "safe_wording": "Passkey sign-in creates a smart account; common gardener flows are sponsored (gasless), while external-wallet operators may pay network gas."
    },
    {
      "id": "operator-review-with-confidence",
      "claim": "Operator approval is what turns submitted work into verified impact — recorded with a confidence band and verification method.",
      "maturity": "available",
      "safe_wording": "Operators — not evaluators — approve or reject submissions, writing confidence and verification method permanently on-chain. Approval gates verified impact; a decision is not guaranteed for every submission (actions can expire unreviewed)."
    },
    {
      "id": "vault-endowments",
      "claim": "Funders endow gardens: principal stays put while yield funds operations.",
      "maturity": "available",
      "safe_wording": "Vault deposits, withdrawals, and yield harvests are live on Arbitrum One."
    },
    {
      "id": "cookie-jar-operations",
      "claim": "Gardens carry small rule-bound operational funds with capped, interval-limited withdrawals.",
      "maturity": "available",
      "safe_wording": "Garden jars are provisioned automatically at garden mint; jar activity beyond creation is not yet indexed, so it does not appear in reports."
    },
    {
      "id": "greenwill-badges",
      "claim": "Gardeners claim recognition badges for milestones like their first submitted work.",
      "maturity": "available",
      "safe_wording": "GreenWill badges are live on Arbitrum with an in-app claim flow (genesis, first submitted work, first support) — the contract validates the Work attestation, not its approval."
    },
    {
      "id": "impact-certificates",
      "claim": "Approved work rolls up into fundable impact certificates.",
      "maturity": "available",
      "safe_wording": "Operators mint Hypercert impact certificates from approved work; marketplace listing exists, and buyer-side flows are still maturing."
    },
    {
      "id": "telegram-agent",
      "claim": "Gardeners can submit work through a Telegram bot.",
      "maturity": "available",
      "safe_wording": "Telegram work submission is live; reviewing submission status happens in the app, not the bot. SMS and WhatsApp are direction, not shipped — never present them as current."
    },
    {
      "id": "commitment-pooling-contracts",
      "claim": "Commitment pooling is live on Arbitrum: gardens can register pools of promises on-chain.",
      "maturity": "deployed-not-available",
      "safe_wording": "The commitment pooling contracts are deployed and unpaused on Arbitrum with 18 pools registered; the in-app experience is still rolling out, so nothing is user-facing yet. A commitment is a record, never a coin."
    },
    {
      "id": "gs-split-settlement",
      "claim": "Fulfilled commitments settle in G$ through a cross-chain payout plan.",
      "maturity": "in-build",
      "safe_wording": "Settlement contracts are deployed but paused with no value authority; G$ never bridges — an Arbitrum command executes on Celo with an authenticated acknowledgment. No value moves today."
    },
    {
      "id": "credit-advances",
      "claim": "Gardens can record interest-free advances and repayments against future work.",
      "maturity": "in-build",
      "safe_wording": "The CreditRegistry is a records-only control plane — it never holds or transfers funds, and there is no credit score, ever. Deployed, not yet in use."
    },
    {
      "id": "community-needs",
      "claim": "Communities will record Needs — problems paired with desired outcomes — that promises and funding can answer.",
      "maturity": "planned",
      "safe_wording": "Needs are a locked architecture (four EAS schemas, two resolvers) with implementation not started; nothing is deployed or user-visible yet."
    },
    {
      "id": "conviction-governance",
      "claim": "Communities signal priorities continuously through conviction voting.",
      "maturity": "in-build",
      "safe_wording": "The Gardens V2 module is deployed, but signal-pool creation needs an initialized community — describe governance chain-readiness as in progress, not live."
    },
    {
      "id": "regenerative-os-vision",
      "claim": "Green Goods is the field-operations layer of a full regenerative coordination stack.",
      "maturity": "vision",
      "safe_wording": "Present the full-stack framing as direction; the shipped product is offline-first documentation, verification, and funding rails on Arbitrum."
    }
  ]
}
