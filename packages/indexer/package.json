{
  "name": "@green-goods/indexer",
  "version": "1.2.1",
  "scripts": {
    "clean": "node ../../scripts/dev/node-cli.js tsc --build --clean",
    "build": "bun run codegen && node ../../scripts/dev/node-cli.js tsc --noEmit",
    "watch": "node ../../scripts/dev/node-cli.js tsc --watch",
    "codegen": "node ../../scripts/dev/node-cli.js envio codegen",
    "dev": "node ../../scripts/dev/package-commands.mjs indexer dev",
    "start": "node --env-file-if-exists=../../.env ./node_modules/envio/bin.mjs start",
    "check:indexing-boundary": "node --test scripts/indexing-boundary-rules.test.mjs scripts/hasura-permissions.test.mjs && node scripts/check-indexing-boundary.mjs",
    "db:up": "node ../../scripts/dev/node-cli.js envio local docker up",
    "db:down": "docker ps -q --filter label=dev.envio.config-hash | xargs -r docker stop",
    "test": "node ../../scripts/dev/package-commands.mjs indexer test",
    "lint": "bun --bun run oxlint src test --deny-warnings",
    "reset": "node ../../scripts/dev/node-cli.js envio stop",
    "docker": "node ../../scripts/dev/package-commands.mjs indexer docker"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.2.1",
    "c8": "11.0.0",
    "mocha": "^11.0.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "envio": "3.6.1",
    "viem": "2.55.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "type": "module"
}
