{
  "name": "@green-goods/indexer",
  "version": "1.2.1",
  "scripts": {
    "clean": "node ../../scripts/dev/node-cli.js tsc --build --clean",
    "build": "bun run codegen && node ../../scripts/dev/node-cli.js tsc --noEmit",
    "watch": "node ../../scripts/dev/node-cli.js tsc --watch",
    "mocha": "node ../../scripts/dev/node-cli.js mocha --require tsx --timeout 30000 \"test/**/*.ts\"",
    "codegen": "node ../../scripts/dev/node-cli.js envio codegen",
    "dev": "bun --env-file=../../.env ../../scripts/dev/node-cli.js envio dev",
    "dev:restart": "bun --env-file=../../.env ../../scripts/dev/node-cli.js envio dev --restart",
    "dev:docker": "docker compose -f docker-compose.indexer.yaml up --build",
    "dev:docker:detach": "docker compose -f docker-compose.indexer.yaml up --build -d",
    "dev:docker:logs": "docker compose -f docker-compose.indexer.yaml logs -f indexer",
    "dev:docker:down": "docker compose -f docker-compose.indexer.yaml down",
    "dev:manual": "bun --env-file=../../.env ../../scripts/dev/node-cli.js envio dev",
    "start": "node --env-file-if-exists=../../.env ./node_modules/envio/bin.mjs start",
    "stop": "docker ps -q --filter label=dev.envio.config-hash | xargs -r docker stop",
    "doctor": "node ../../scripts/dev/doctor.js --profile full",
    "check:indexing-boundary": "node --test scripts/check-indexing-boundary.test.mjs && node scripts/check-indexing-boundary.mjs",
    "db:up": "node ../../scripts/dev/node-cli.js envio local docker up",
    "db:down": "docker ps -q --filter label=dev.envio.config-hash | xargs -r docker stop",
    "test": "bun run codegen && bun run mocha",
    "test:coverage": "c8 bun run mocha",
    "test:coverage:ci": "c8 --reporter text --reporter json bun run mocha",
    "test:full": "bun run test",
    "lint": "bun --bun run oxlint src test --deny-warnings",
    "reset": "node ../../scripts/dev/node-cli.js envio stop"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.2.1",
    "c8": "11.0.0",
    "mocha": "^11.0.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "envio": "3.6.1",
    "viem": "2.55.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "type": "module"
}
