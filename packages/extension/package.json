{
  "name": "@green-goods/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Grove G0 feasibility spike: a disposable MV3 extension that measures the four prototype parts",
  "scripts": {
    "prepare:wxt": "wxt prepare",
    "build": "wxt build",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json",
    "lint": "bun --bun run oxlint src entrypoints g0 --deny-warnings",
    "test": "wxt prepare && vitest run",
    "g0": "node g0/run-g0.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@huggingface/transformers": "4.3.2",
    "graphology": "0.26.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sigma": "4.0.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "^6.2.5",
    "graphology-types": "0.24.8",
    "typescript": "~7.0.2",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
