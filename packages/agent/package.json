{
  "name": "@green-goods/agent",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "APP_ENV=development bun --env-file=../../.env --watch src/index.ts",
    "intake:smoke": "APP_ENV=development bun --env-file=../../.env scripts/intake-smoke.ts",
    "build": "node ../../scripts/dev/node-cli.js tsc",
    "start": "APP_ENV=production bun --env-file=../../.env dist/index.js",
    "lint": "bun --bun run oxlint src",
    "test": "APP_ENV=test node ../../scripts/dev/node-cli.js vitest run",
    "test:watch": "APP_ENV=test node ../../scripts/dev/node-cli.js vitest",
    "test:coverage": "APP_ENV=test bun scripts/run-coverage.mjs",
    "test:ui": "APP_ENV=test node ../../scripts/dev/node-cli.js vitest --ui",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "node ../../scripts/dev/node-cli.js tsc --noEmit",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org ${SENTRY_ORG:-greenpill} --project ${SENTRY_AGENT_PROJECT:-green-goods-agent} ./dist && sentry-cli sourcemaps upload --org ${SENTRY_ORG:-greenpill} --project ${SENTRY_AGENT_PROJECT:-green-goods-agent} ./dist"
  },
  "dependencies": {
    "@green-goods/shared": "workspace:*",
    "@sentry/bun": "10.65.0",
    "@sentry/cli": "^2",
    "@xenova/transformers": "^2.17.1",
    "hono": "4.12.30",
    "pino": "10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-node": "5.41.0",
    "telegraf": "^4.16.3",
    "viem": "2.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "bun-types": "latest",
    "typescript": "~7.0.2",
    "vitest": "4.1.10"
  }
}
