{
  "name": "@green-goods/agent",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "APP_ENV=development bun --env-file=../../.env --watch src/index.ts",
    "intake:smoke": "APP_ENV=development bun --env-file=../../.env scripts/intake-smoke.ts",
    "build": "node ../../scripts/dev/node-cli.js tsc",
    "start": "APP_ENV=production bun --env-file=../../.env dist/index.js",
    "lint": "bun --bun run oxlint src --deny-warnings",
    "test": "node ../../scripts/dev/package-commands.mjs agent test",
    "format": "node ../../scripts/dev/package-commands.mjs agent format",
    "typecheck": "node ../../scripts/dev/package-commands.mjs agent typecheck",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org ${SENTRY_ORG:-greenpill} --project ${SENTRY_AGENT_PROJECT:-green-goods-agent} ./dist && sentry-cli sourcemaps upload --org ${SENTRY_ORG:-greenpill} --project ${SENTRY_AGENT_PROJECT:-green-goods-agent} ./dist"
  },
  "dependencies": {
    "@green-goods/shared": "workspace:*",
    "@sentry/bun": "10.65.0",
    "@sentry/cli": "3.6.0",
    "@huggingface/transformers": "4.2.0",
    "hono": "4.13.5",
    "pino": "10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-node": "5.41.0",
    "telegraf": "^4.16.3",
    "viem": "2.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "bun-types": "latest",
    "typescript": "~7.0.2",
    "vitest": "4.1.11"
  }
}
