{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "bun-types", "vitest/globals"]
  },
  "include": [
    "src/env.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/__tests__/**/*",
    "../shared/src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
