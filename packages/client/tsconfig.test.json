{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "isolatedModules": true,
    "tsBuildInfoFile": "./.tsbuildinfo/test.tsbuildinfo",
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/vite-env.d.ts",
    "src/types/**/*.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.stories.*",
    "src/__tests__/**/*",
    "src/__mocks__/**/*",
    "../shared/src/types/**/*.d.ts",
    "../../env.d.ts"
  ],
  "exclude": ["node_modules"]
}
