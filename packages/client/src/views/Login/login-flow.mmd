flowchart TD
    Start(["Open Green Goods PWA"]) --> Ready{"Auth ready?"}
    Ready -->|Restoring session| Boot["Boot splash"]
    Ready -->|Authenticated| App(["Enter app"])
    Ready -->|Signed out| Stored{"Passkey remembered?"}
    Stored -->|No| New["Continue with Passkey · Wallet"]
    Stored -->|Yes| Returning["Continue as remembered user · Wallet<br/>Use Different Username"]
    Returning -->|Continue as remembered user| Cached["Existing passkey prompt"]
    Cached -->|Verified| App
    Cached -->|Canceled or failed| Returning
    New -->|Continue with Passkey| Username["Username input · Continue · Back"]
    Returning -->|Use Different Username| Username
    Username -->|Back| Stored
    Username -->|Continue| Lookup{"Directory and legacy name lookup"}
    Lookup -->|Existing name or matching saved passkey| SignIn["Existing passkey prompt"]
    Lookup -->|Available name| Register["New account passkey prompt"]
    Lookup -->|Lookup failed| Error["Error on the same username form"]
    SignIn -->|Verified with original identity| App
    SignIn -->|Canceled or failed| Error
    Register -->|Created with site default profile| App
    Register -->|Canceled, failed, or name claimed meanwhile| Error
    Error -->|Retry| Lookup
    Error -->|Back| Stored
    New -->|Wallet| Wallet["Connect wallet"]
    Returning -->|Wallet| Wallet
    Wallet -->|Connected| App
    Stored -->|No · local-only development| Local["Create Account · Wallet"]
    Local -->|Create Account| LocalForm["Username input · Create Account · Back"]
    LocalForm -->|Create Account| Register
    LocalForm -->|Back| Local
