{
  "name": "@green-goods/client",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/dev/check-port.js 3001 client",
    "dev": "APP_ENV=development node ../../scripts/dev/node-cli.js vite",
    "test": "APP_ENV=test node ../../scripts/dev/node-cli.js vitest run",
    "test:watch": "APP_ENV=test vitest --standalone",
    "coverage": "APP_ENV=test node ../../scripts/dev/node-cli.js vitest run --coverage",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "bun --bun run oxlint src --deny-warnings",
    "build": "APP_ENV=production node ../../scripts/dev/node-cli.js tsc --noEmit && node ../../scripts/dev/node-cli.js vite build && bun run check:pwa-precache && node ../../scripts/dev/remove-public-sourcemaps.js dist",
    "check:pwa-precache": "node scripts/check-pwa-precache-budget.mjs",
    "preview": "APP_ENV=production bun --bun vite preview"
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-sdk": "2.9.0",
    "@green-goods/shared": "workspace:*",
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-accordion": "1.2.16",
    "@radix-ui/react-avatar": "1.2.2",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@remixicon/react": "4.9.0",
    "@sentry/react": "10.65.0",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-query-persist-client": "5.101.2",
    "embla-carousel-react": "^8.6.0",
    "idb": "^8.0.3",
    "idb-keyval": "6.3.0",
    "posthog-js": "1.399.2",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-device-frameset": "1.3.4",
    "react-dom": "19.2.7",
    "react-helmet-async": "3.0.0",
    "react-hook-form": "7.81.0",
    "react-hot-toast": "^2.4.1",
    "react-intl": "^10.1.15",
    "react-router-dom": "7.18.1",
    "react-window": "2.2.7",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "thirdweb": "5.120.1",
    "viem": "2.55.0",
    "wagmi": "^2.19.5",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@reown/appkit": "1.8.22",
    "@rolldown/plugin-babel": "0.2.3",
    "@sentry/vite-plugin": "5.4.0",
    "@types/babel__core": "7.20.5",
    "@vitejs/plugin-react": "6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "opentype.js": "^2.0.0",
    "tailwindcss": "4.2.4",
    "typescript": "~7.0.2",
    "vite": "8.1.4",
    "vite-plugin-mkcert": "2.1.0",
    "vite-plugin-pwa": "1.3.0",
    "workbox-build": "7.4.1"
  }
}
