{
  "name": "@green-goods/contracts",
  "version": "1.2.1",
  "private": true,
  "description": "Contracts for Green Goods Protocol",
  "exports": {
    "./deployments/*.json": "./deployments/*.json",
    "./abis/*.json": "./abis/*.json"
  },
  "scripts": {
    "predev": "node ../../scripts/dev/check-port.js ${ANVIL_PORT:-3009} anvil",
    "dev": "mkdir -p .generated/runtime && anvil --port ${ANVIL_PORT:-3009} --config-out .generated/runtime/localhost.json",
    "dev:arbitrum-fork": "bash script/run-arbitrum-fork.sh",
    "check:foundry-version": "node ../../scripts/contracts/check-foundry-version.mjs",
    "format": "bun run check:foundry-version && forge fmt",
    "format:check": "bun run check:foundry-version && forge fmt --check",
    "lint": "bun run format && solhint --config ./.solhint.json 'src/**/*.sol' --ignore-path .solhintignore",
    "lint:check": "bun run format:check && solhint --config ./.solhint.json 'src/**/*.sol' --ignore-path .solhintignore",
    "lint:fix": "bun run format && solhint --config ./.solhint.json 'src/**/*.sol' --ignore-path .solhintignore --fix",
    "build": "bun script/utils/build-adaptive.ts",
    "build:changed": "bun script/utils/build-changed.ts",
    "build:target": "bun script/utils/build-target.ts",
    "build:abis": "bun script/build-abis.ts",
    "build:fast": "GG_CONTRACTS_BUILD_MODE=fast bun run build",
    "build:full": "GG_CONTRACTS_BUILD_MODE=full bun run build",
