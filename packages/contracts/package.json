{
  "name": "@green-goods/contracts",
  "version": "1.2.1",
  "private": true,
  "description": "Contracts for Green Goods Protocol",
  "exports": {
    "./deployments/*.json": "./deployments/*.json",
    "./abis/*.json": "./abis/*.json"
  },
  "scripts": {
    "predev": "node ../../scripts/dev/check-port.js ${ANVIL_PORT:-3009} anvil",
    "dev": "mkdir -p .generated/runtime && anvil --port ${ANVIL_PORT:-3009} --config-out .generated/runtime/localhost.json",
    "dev:arbitrum-fork": "bash script/run-arbitrum-fork.sh",
    "check:foundry-version": "node ../../scripts/contracts/check-foundry-version.mjs",
    "format": "node ../../scripts/dev/node-cli.js node script/utils/package-commands.mjs format",
    "lint": "node ../../scripts/dev/node-cli.js node script/utils/package-commands.mjs lint",
    "build": "node ../../scripts/dev/node-cli.js node script/utils/package-commands.mjs build",
    "build:abis": "bun script/build-abis.ts",
    "check:sizes": "bun script/utils/check-contract-sizes.ts",
    "check:storage-layout": "bash script/check-storage-layout.sh",
    "clean": "node ../../scripts/dev/node-cli.js node script/utils/package-commands.mjs clean",
    "typecheck": "node ../../scripts/dev/node-cli.js tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/dev/node-cli.js node script/utils/package-commands.mjs test",
    "test:e2e": "bash script/utils/run-e2e.sh",
    "test:fork": "node ../../scripts/dev/node-cli.js node script/utils/package-commands.mjs fork",
    "test:audit": "node ../../scripts/dev/node-cli.js node script/utils/package-commands.mjs audit",
    "test:shard": "bun script/utils/fork-shards.mjs",
    "contracts": "node script/cli.mjs"
  },
  "dependencies": {
    "@chainlink/contracts-ccip": "^1.6.4",
    "@ethereum-attestation-service/eas-contracts": "1.9.0",
    "@openzeppelin/contracts-5.0.2": "npm:@openzeppelin/contracts@5.0.2",
    "@openzeppelin/contracts-upgradeable": "4.9.6",
    "dotenv": "^16.4.5",
    "js-yaml": "5.2.2"
  },
  "devDependencies": {
    "bun-types": "latest",
    "solhint": "^6.0.1"
  }
}
