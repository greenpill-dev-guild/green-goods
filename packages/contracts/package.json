    "build:fresh": "bun run clean:artifacts && forge build",
    "build:core": "forge build --skip test --skip script",
    "typecheck": "node ../../scripts/dev/node-cli.js tsc --noEmit -p tsconfig.json",
    "test": "bun run typecheck && FOUNDRY_PROFILE=test forge test --no-match-contract 'E2E' --no-match-path 'test/fork/**' --no-match-test '^(testSettlementFunding_proposedFundedBatchAcknowledgmentFitsTheFixedSourceGasBudget|testSettlementFunding_nextFundedBatchSizeDoesNotFitTheFixedSourceGasBudget|testSettlementFunding_hardMaxFundedBatchAcknowledgmentDoesNotFitTheFixedSourceGasBudget)\\(\\)$' && bun run test:gas:release && bun run test:script",
    "test:solidity": "FOUNDRY_PROFILE=test forge test --no-match-contract 'E2E' --no-match-path 'test/fork/**' --no-match-test '^(testSettlementFunding_proposedFundedBatchAcknowledgmentFitsTheFixedSourceGasBudget|testSettlementFunding_nextFundedBatchSizeDoesNotFitTheFixedSourceGasBudget|testSettlementFunding_hardMaxFundedBatchAcknowledgmentDoesNotFitTheFixedSourceGasBudget)\\(\\)$'",
    "test:deep": "FOUNDRY_PROFILE=ci forge test --no-match-contract 'E2E' --no-match-path 'test/fork/**' --no-match-test '^(testSettlementFunding_proposedFundedBatchAcknowledgmentFitsTheFixedSourceGasBudget|testSettlementFunding_nextFundedBatchSizeDoesNotFitTheFixedSourceGasBudget|testSettlementFunding_hardMaxFundedBatchAcknowledgmentDoesNotFitTheFixedSourceGasBudget)\\(\\)$'",
    "test:script": "node ../../scripts/dev/node-cli.js vitest run script/**/*.test.ts",
    "test:fast": "FOUNDRY_PROFILE=test forge test --no-match-contract 'E2E|Fork' --no-match-test '^(testSettlementFunding_proposedFundedBatchAcknowledgmentFitsTheFixedSourceGasBudget|testSettlementFunding_nextFundedBatchSizeDoesNotFitTheFixedSourceGasBudget|testSettlementFunding_hardMaxFundedBatchAcknowledgmentDoesNotFitTheFixedSourceGasBudget)\\(\\)$'",
    "test:lite": "FOUNDRY_PROFILE=test forge test --no-match-path 'test/integration/Garden*|test/unit/GardenAccount*|test/unit/GardenToken*|test/E2E*|test/Fuzz*|test/Gas*|test/Storage*|test/Upgrade*|test/fork/e2e/*|test/fork/eas/*|test/fork/gardens/*' --no-match-test '^(testSettlementFunding_proposedFundedBatchAcknowledgmentFitsTheFixedSourceGasBudget|testSettlementFunding_nextFundedBatchSizeDoesNotFitTheFixedSourceGasBudget|testSettlementFunding_hardMaxFundedBatchAcknowledgmentDoesNotFitTheFixedSourceGasBudget)\\(\\)$'",
    "test:gas": "forge test --gas-report --no-match-contract 'E2E'",
    "test:gas:release": "bun script/utils/run-release-gas-gate.ts",
    "test:match": "forge test --match-path",
    "test:e2e": "bash script/utils/run-e2e.sh full",
    "test:e2e:workflow": "bash script/utils/run-e2e.sh workflow",
    "test:e2e:karma": "bash script/utils/run-e2e.sh karma",
    "test:e2e:sepolia": "bash script/utils/run-e2e.sh sepolia",
    "test:e2e:arbitrum": "bash script/utils/run-e2e.sh arbitrum",
    "test:e2e:celo": "bash script/utils/run-e2e.sh celo",
    "test:fork": "set -a && . ../../.env 2>/dev/null || true && set +a && FOUNDRY_PROFILE=fork forge test --match-path 'test/fork/**' -vvv",
    "test:fork:protocol": "set -a && . ../../.env 2>/dev/null || true && set +a && FOUNDRY_PROFILE=fork forge test --match-path 'test/fork/**' --no-match-test '.*[cC]elo.*|.*[uU]nlock.*' -vvv",
    "test:fork:protocol:ci": "set -a && . ../../.env 2>/dev/null || true && set +a && FOUNDRY_PROFILE=fork forge test --match-path 'test/fork/**' --no-match-test '.*[cC]elo.*|.*[uU]nlock.*' --threads 1 -vvv",
