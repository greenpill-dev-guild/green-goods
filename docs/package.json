{
  "name": "@green-goods/docs",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "docusaurus": "node ../scripts/dev/node-cli.js docusaurus",
    "predev": "node ../scripts/dev/check-port.js 3003 docs",
    "dev": "node ../scripts/dev/node-cli.js docusaurus start --port 3003 --no-open",
    "test": "bun test",
    "build": "node ../scripts/dev/node-cli.js docusaurus build && node scripts/check-search-index.mjs",
    "check:search-index": "node scripts/check-search-index.mjs",
    "audit": "node scripts/docs-audit.mjs",
    "typecheck": "node ../scripts/dev/node-cli.js tsc",
    "cms:dev": "node ../scripts/dev/node-cli.js tinacms dev --noTelemetry -c \"node ../scripts/dev/node-cli.js docusaurus start --port 3003 --no-open\"",
    "cms:build": "node ../scripts/dev/node-cli.js tinacms build --noTelemetry"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "^3.0.0",
    "@remixicon/react": "4.9.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tinacms": "3.15.1"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@tinacms/cli": "4.0.4",
    "@tinacms/graphql": "4.1.0",
    "@tinacms/schema-tools": "2.11.0",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "typescript": "~7.0.2",
    "unified": "11.0.5"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.19.0 <23"
  }
}
