# Filename patterns in package source. A source file under packages/<name>/src whose name
# contains passkey, wallet or batch needs a lead, so new auth and money code is covered before
# it gets a folder below. Plans, docs, scripts and end-to-end specs sit outside packages/*/src,
# so they no longer match. CODEOWNERS has no [Aa] ranges, so both cases are listed.
/packages/*/src/**/*passkey* @greenpill-dev-guild/engineering-leads
/packages/*/src/**/*Passkey* @greenpill-dev-guild/engineering-leads
/packages/*/src/**/*wallet* @greenpill-dev-guild/engineering-leads
/packages/*/src/**/*Wallet* @greenpill-dev-guild/engineering-leads
/packages/*/src/**/*batch* @greenpill-dev-guild/engineering-leads
/packages/*/src/**/*Batch* @greenpill-dev-guild/engineering-leads

# Unit tests, mocks and stories in package source have no owner here: a line without an owner
# clears the patterns above for those files. The production folders below come later, so
# their own tests and stories stay owned (last match wins).
/packages/*/src/**/__tests__/
/packages/*/src/**/__mocks__/
/packages/*/src/**/*.test.*
/packages/*/src/**/*.spec.*
/packages/*/src/**/*.stories.*

# Production-affecting paths: an engineering lead reviews before merge, so agents
# cannot merge them on their own. Merging to develop deploys the Agent and QA apps.
/packages/agent/** @greenpill-dev-guild/engineering-leads
