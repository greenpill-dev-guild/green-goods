# env.schema: the one checked-in environment file for Green Goods.
#
# It names every variable and holds the value `bun run env:sync` writes to the root `.env`:
# a plain default, nothing, or a 1Password secret reference for a secret the team shares.
# The sync hands this whole file to the 1Password CLI, which swaps each reference for its
# secret, so `.env` is this file with the references resolved. Personal credentials go
# straight into your own `.env`.
#
# Annotations sit on the comment lines above a key:
#   @required-in <profiles>  Enforced. `bun run env:check --profile <name>` fails, and a
#                            Vercel production build stops, when the key is missing or empty
#                            for that profile. Without --profile the check uses `dev`.
#   @public                  Documentation. The value is safe to print or publish. Treat a
#                            key without it as sensitive unless its name starts with VITE_;
#                            those ship in the browser bundle.
#   @type, @required=        Documentation. No check reads them.
#
# Keep secret references out of comments. The CLI resolves a reference wherever it appears,
# so an example in a comment fails the sync for everyone. A reference is a whole value: the
# 1Password URI scheme followed by vault/item/field.

# =====================================================================
# Environment selector
# =====================================================================

# @public
# @type=enum(development,test,staging,production)
# @required-in dev
APP_ENV=development

# =====================================================================
# Workspace lifecycle
# =====================================================================

# Non-secret setup profile for host, isolated worktree, and container flows.
# Setup behavior must key off environment shape, not agent identity.
# @public
# @type=enum(host,isolated,cloud)
GG_WORKSPACE_PROFILE=host

# Dependency install policy for setup. `auto` installs on host and when an
# isolated workspace lacks node_modules; `skip` is for pre-baked containers.
# @public
# @type=enum(auto,always,skip)
GG_SETUP_INSTALL=auto

# Environment materialization policy for setup. `baseline` writes only the
# non-secret web defaults needed by env:check; `skip` leaves env untouched.
# @public
# @type=enum(auto,baseline,skip)
GG_SETUP_ENV_MODE=auto

# =====================================================================
# 1Password (optional; not needed for baseline web)
# =====================================================================

# Baseline web development works without shared secrets or 1Password. The CLI is needed
# only for `bun run env:sync`, which resolves the secret references in this file.

# Service account token used in CI/deployed environments.
# Optional locally if you prefer service-account auth over desktop app auth.
OP_SERVICE_ACCOUNT_TOKEN=

# Optional 1Password account shorthand/id for the `op` CLI when multiple
# accounts are configured locally.
OP_ACCOUNT=

# =====================================================================
# Authentication and wallet
# =====================================================================

# @public
# @required-in production,production-client,production-admin,sourcemaps-client,sourcemaps-admin
VITE_WALLETCONNECT_PROJECT_ID=op://GreenGoods/VITE_WALLETCONNECT_PROJECT_ID/credential

# @public
# @required-in production,production-client,production-admin,sourcemaps-client,sourcemaps-admin
VITE_PIMLICO_API_KEY=op://GreenGoods/VITE_PIMLICO_API_KEY/credential

# Optional local-development relying party override; deployed sites use greengoods.app.
# @public
VITE_PASSKEY_RP_ID=
# Local development only: enable the agent passkey directory instead of local-only passkeys.
# Deployed sites always use the directory at VITE_API_BASE_URL.
# @public
# @type=boolean
VITE_PASSKEY_SERVER_ENABLED=false

# Arbitrum One, the chain the local stack runs against. CI, the push gate and the isolated
# setup baseline set their own value.
# @public
# @type=number
# @required-in dev,production,production-client,production-admin,sourcemaps-client,sourcemaps-admin
VITE_CHAIN_ID=42161
# Optional dev-surfaces override. Leave blank in shared env files; the
# Green Goods dev surface sets this to `arbitrum_fork` for local fork mode.
# @public
VITE_DEV_CHAIN_MODE=
# @public
VITE_LOCAL_FORK_RPC_URL=
# When true, PM2 replaces an inherited local agent URL with the root or hosted agent URL.
# @public
# @type=boolean
VITE_DISABLE_LOCAL_AGENT=false
# When true, PM2 replaces inherited local-chain Vite settings with the root chain configuration.
# @public
# @type=boolean
VITE_DISABLE_LOCAL_CHAIN=false
# When true, PM2 replaces the local indexer URL with the root or hosted indexer URL.
# @public
# @type=boolean
VITE_DISABLE_LOCAL_INDEXER=false
# @public
# @type=boolean
VITE_ENABLE_ANVIL_WALLETS=false

# =====================================================================
# RPC and network
# =====================================================================

ALCHEMY_API_KEY=op://GreenGoods/ALCHEMY_API_KEY/credential
# Aliases used by some scripts.
VITE_ALCHEMY_API_KEY=op://GreenGoods/VITE_ALCHEMY_API_KEY/credential
ALCHEMY_KEY=op://GreenGoods/ALCHEMY_API_KEY/credential

# Keep standard RPC URL vars blank by default. Runtime helpers provide public
# fallbacks; explicit env values may contain provider keys and must stay private.
ARBITRUM_RPC_URL=
CELO_RPC_URL=
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
OPTIMISM_RPC_URL=

# Required for reliable live-indexer mirror catch-up through Envio HyperSync.
ENVIO_API_TOKEN=

# Optional high-capacity overrides for Foundry fork tests.
# Prefer dedicated provider URLs here when public endpoints start rate-limiting.
ARBITRUM_FORK_RPC_URL=
SEPOLIA_FORK_RPC_URL=
CELO_FORK_RPC_URL=

# Optional fork pins for deterministic reruns against live chains.
ARBITRUM_FORK_BLOCK_NUMBER=
SEPOLIA_FORK_BLOCK_NUMBER=
CELO_FORK_BLOCK_NUMBER=

