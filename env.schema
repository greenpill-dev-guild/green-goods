# =====================================================================
# Agent reporting
# =====================================================================

# Versioned key list for private reporting data: `version:base64key` entries, comma separated,
# current first, each key 32 bytes. Reporting starts once this is set and a chat channel is
# available. Keep it; replace it only by rotating (add a new first entry).
AGENT_REPORTING_KEYS=
# Optional separate wrapping key ring for per-grant delegated signers under /data/reporting-signers.
# Same version:base64key format; use different key material from AGENT_REPORTING_KEYS. Retain old
# versions until every signer wrapped by them is revoked and rewrapped or deleted.
AGENT_REPORTING_SIGNER_KEYS=
# Provider keys for the versions pinned in reporting/config.ts: gpt-4.1-mini-2025-04-14,
# gpt-4o-mini-transcribe-2025-12-15 and jev-1.13.0. Models are not selected by environment.
# Missing keys preserve deterministic text questions; runtime controls still govern processing.
AGENT_REPORTING_OPENAI_API_KEY=
AGENT_REPORTING_JEV_API_KEY=
# The Green Goods site a deployed Agent runs its reporting ceremonies on: its links point there and
# the ceremony API accepts no other origin. `production` is https://www.greengoods.app, built from
# main. `beta` is https://beta.greengoods.app, built from develop, for testing against the live
# Agent before main carries a release. The addresses are fixed in reporting/config.ts. With
# reporting on, an unknown name stops the Agent at start-up. Outside production the local Client
# dev server is used whichever site is named.
# @public
# @type=enum(production,beta)
AGENT_REPORTING_SITE=production
