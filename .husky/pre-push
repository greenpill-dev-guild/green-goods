#!/usr/bin/env sh
set -eu

# git exports GIT_DIR to hooks in a linked worktree, and a git that inherits it ignores `cwd`, so
# a test fixture run by this gate works on this repository instead of its throwaway one. Clear
# every variable that binds git to a repository (git lists them itself). Worktrees whose hooks
# path points at the main checkout run this file, so it protects them even on older code.
unset $(git rev-parse --local-env-vars)

# Enable pipefail only if supported (dash doesn't support it)
(set -o pipefail) 2>/dev/null && set -o pipefail

# Add common package manager bin paths to PATH
export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"

# Only try nvm when running in bash (nvm isn't POSIX-sh safe)
if [ -n "${BASH_VERSION-}" ] && [ -f .nvmrc ]; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh"
    nvm use --silent >/dev/null 2>&1 || true
  fi
fi

echo "🔍 Running the focused ready-for-CI gate..."

# Bun is the repository's required package manager.
if ! command -v bun >/dev/null 2>&1; then
  echo "Error: Bun is required. Install bun: https://bun.sh"
  exit 1
fi
# Run the gate through the repo's Node wrapper so a Bun or wrong-Node shell still reaches real
# Node. The gate then re-execs itself under the exact pinned Node, because a plan that reads
# "blocked:toolchain.node" on every check only teaches people to reach for --no-verify.
# Optional whitespace-separated surface:path entries select direct proof, just as --test-path
# does for a manual gate. GG_PUSH_GATE_ARGS may add the gate's own focus flags, and only those:
# --check <id> and --test-path <surface:path>. Anything else (--plan, --only-lint, a skip flag, or
# --base, which can empty the diff the gate validates) would change what the gate runs, so the hook
# refuses it instead of forwarding it.
# Disable glob expansion and keep every entry a separate argument.
set --
set -f
for test_path in ${GREEN_GOODS_PUSH_TEST_PATHS:-}; do
  set -- "$@" --test-path "$test_path"
done
gate_flag=""
for gate_arg in ${GG_PUSH_GATE_ARGS:-}; do
  if [ -n "$gate_flag" ]; then
    case "$gate_arg" in
      -*)
        echo "pre-push: GG_PUSH_GATE_ARGS gives $gate_flag no value" >&2
        exit 1
        ;;
    esac
    set -- "$@" "$gate_flag" "$gate_arg"
    gate_flag=""
    continue
  fi
  case "$gate_arg" in
    --check|--test-path) gate_flag="$gate_arg" ;;
    *)
      echo "pre-push: GG_PUSH_GATE_ARGS may only carry --check <id> or --test-path <surface:path> (--base is refused: it can empty the diff the gate validates); refusing '$gate_arg'" >&2
      exit 1
      ;;
  esac
done
if [ -n "$gate_flag" ]; then
  echo "pre-push: GG_PUSH_GATE_ARGS ends with $gate_flag and no value" >&2
  exit 1
fi
set +f
node scripts/dev/node-cli.js scripts/dev/ci-local.js --intent push --reuse-passing-receipts "$@"
