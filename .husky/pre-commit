#!/usr/bin/env sh
set -eu

# Enable pipefail only if supported (dash doesn't support it)
(set -o pipefail) 2>/dev/null && set -o pipefail

# Add common package manager bin paths to PATH
export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"

# Only try nvm when running in bash (nvm isn't POSIX-sh safe)
if [ -n "${BASH_VERSION-}" ] && [ -f .nvmrc ]; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh"
    nvm use --silent >/dev/null 2>&1 || true
  fi
fi

# Refuse a commit made under an address reserved for tests. A fixture once wrote its identity into
# this repository's config and authored 42 commits before anyone noticed. The push gate catches a
# poisoned config, but only at push time, which is too late for the commits already made.
# GIT_DIR is deliberately left alone here: lint-staged needs the index a partial commit sets.
node scripts/quality/check-commit-identity.mjs --pending

# Run lint-staged through the repository's required package manager.
if ! command -v bun >/dev/null 2>&1; then
  echo "Error: Bun is required. Install bun: https://bun.sh"
  exit 1
fi

bunx lint-staged
