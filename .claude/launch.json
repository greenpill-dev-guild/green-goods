{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--filter", "@green-goods/shared", "storybook"],
      "port": 3004
    },
    {
      "name": "admin",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--filter", "@green-goods/admin", "dev"],
      "port": 3002
    },
    {
      "name": "proto",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4601", "--bind", "127.0.0.1", "-d", "/tmp/gg-proto"],
      "port": 4601
    },
    {
      "name": "storybook-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4620",
        "--bind",
        "127.0.0.1",
        "-d",
        "packages/shared/storybook-static"
      ],
      "port": 4620
    }
  ]
}
