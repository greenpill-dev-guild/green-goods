      "excludeValidationOnlyFrom": ["shared"]
    },
    {
      "check": "supply-chain",
      "exact": [
        "package.json",
        "bun.lock",
        "bun.lockb",
        ".npmrc",
        "bunfig.toml",
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "prefixes": [
        ".github/workflows/",
        ".codex/",
        ".claude/",
        ".plans/",
        "scripts/quality/",
        "scripts/harness/"
      ]
    },
    {
      "check": "agent-guidance",
      "runInQa": true,
      "runInEvidence": true,
      "exact": [
        "AGENTS.md",
        "CLAUDE.md",
        ".claude/context/codebase-architecture.md",
        ".claude/skills/plan/SKILL.md",
        ".claude/skills/review/SKILL.md",
        ".claude/skills/audit/SKILL.md",
        ".claude/skills/module-seams-review/SKILL.md",
        ".claude/skills/module-seams-review/references/review-matrix.md",
        "scripts/data/module-seam-registry.json",
        "scripts/data/direct-tested-seam-baseline.json",
        "scripts/quality/check-direct-tested-seams.mjs",
        "scripts/quality/check-direct-tested-seams.test.mjs",
        "scripts/quality/check-codex-docs.js",
        "scripts/quality/check-guidance-links.mjs",
        "scripts/quality/check-skill-behavior-contracts.mjs",
        "docs/docs/builders/agentic/claude-code.mdx",
        "docs/docs/builders/agentic/context-engineering.mdx",
        "docs/docs/builders/agentic/spec-engineering.mdx"
