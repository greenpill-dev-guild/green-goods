    {
      "check": "agent-tools-test",
      "runInQa": true,
      "runInEvidence": true,
      "exact": [
        "scripts/data/qa-test-catalog.json",
        "scripts/agents/qa-workbook-build.ts",
        "scripts/agents/qa-workbook-build.test.ts",
        "scripts/agents/posthog-query.ts",
        "scripts/agents/posthog-query.test.ts"
      ]
    }
